# Copy to .env (read by the API server). All values are optional; defaults shown.

# Where uploads, generated visualizations and the SQLite database are stored.
# ARTIFACTDIFF_DATA_DIR=~/.local/share/artifactdiff   (Windows: %LOCALAPPDATA%\artifactdiff)

# SQLAlchemy URL. Default: SQLite inside DATA_DIR. PostgreSQL needs the "postgres" extra:
# ARTIFACTDIFF_DATABASE_URL=postgresql+psycopg://artifactdiff:secret@localhost:5432/artifactdiff

ARTIFACTDIFF_MAX_UPLOAD_MB=512
ARTIFACTDIFF_INPUT_RETENTION_HOURS=24      # uploaded files are deleted after this
ARTIFACTDIFF_RESULT_RETENTION_DAYS=0       # 0 = keep results until deleted
ARTIFACTDIFF_TIMEOUT_SECONDS=300
ARTIFACTDIFF_MAX_CHANGES=10000
ARTIFACTDIFF_ISOLATION=process             # process (hard timeouts, crash isolation) | inline
ARTIFACTDIFF_MAX_CONCURRENT_JOBS=2
# ARTIFACTDIFF_MEMORY_LIMIT_MB=4096        # per worker, POSIX only
ARTIFACTDIFF_RATE_LIMIT_PER_MINUTE=30      # POST /compare per client; 0 disables

# Require "Authorization: Bearer <token>" on every API call except /health.
# Set this whenever the server is reachable by anyone but you.
# ARTIFACTDIFF_API_TOKEN=change-me

# JSON list of allowed browser origins (the dev server on :5173 by default).
# ARTIFACTDIFF_CORS_ORIGINS=["http://localhost:5173"]
